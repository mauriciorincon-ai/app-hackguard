{
  "name": "app-hackguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copiar-maqueta.mjs && next build",
    "start": "serve out -l tcp://127.0.0.1:${PORT:-3000} --config ../serve.json",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "catalogo:validar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/catalogo.ts validar",
    "catalogo:instantanea": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/catalogo.ts instantanea",
    "catalogo:diferencias": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/catalogo.ts diferencias",
    "activo:historial": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/activo.ts historial",
    "activo:desde-ficha": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/activo.ts desde-ficha",
    "activo:validar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/plan.ts activo-validar",
    "plan:emitir": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/plan.ts emitir",
    "plan:replanear": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/plan.ts replanear",
    "ejecutor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/ejecutor.ts",
    "exportar:defectdojo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/exportar.ts defectdojo",
    "evidencia:validar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts validar",
    "evidencia:registrar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts registrar",
    "evidencia:confirmar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts confirmar",
    "evidencia:importar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts importar",
    "evidencia:confirmar-lote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts confirmar-lote",
    "hallazgos:listar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts hallazgos-listar",
    "supuestos:generar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/supuestos.ts generar",
    "supuestos:s3": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/supuestos.ts s3",
