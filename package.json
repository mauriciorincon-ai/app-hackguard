    "brecha:tendencia": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/brecha.ts tendencia",
    "hallazgo:cadena": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts hallazgo-cadena",
    "hallazgos:declarar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/evidencia.ts hallazgos-declarar",
    "propuestas:buscar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts buscar",
    "propuestas:leer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts leer",
    "propuestas:aportar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts aportar",
    "propuestas:verificar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts verificar",
    "propuestas:validar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts validar",
    "propuestas:listar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts listar",
    "propuestas:decidir": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/propuestas.ts decidir",
    "severidad:vendor": "node scripts/severidad/vendor-first.mjs",
    "clasificador:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/clasificador-demo.ts",
    "prepare": "git config core.hooksPath githooks",
    "maqueta": "node scripts/maqueta/generar.mjs",
    "capturas:maqueta": "node scripts/capturar-maqueta.mjs",
    "capturas:ficha": "node scripts/capturas-ficha.mjs",
    "brochure": "node scripts/brochure.mjs",
    "tokens": "node scripts/paleta/generar-tokens.mjs",
    "design-sync:bundle": "node scripts/design-sync/generar.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.10.0",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "serve": "14.2.6",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18"
  }
}
