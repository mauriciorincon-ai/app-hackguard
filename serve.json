{
  "cleanUrls": [
    "/!(diseno)",
    "/!(diseno)/**"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/tablero",
      "type": 307
    },
    {
      "source": "/diseno",
      "destination": "/diseno/index.html",
      "type": 307
    },
    {
      "source": "/diseno/",
      "destination": "/diseno/index.html",
      "type": 307
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "diseno/**",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "conoce{,/**}",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'sha256-KoWKWpozjqYnaef/jfYdC36V0YrkF9n++c0TiA6qsUQ='; style-src 'sha256-VGAXekz9Y+yN9xGOMBuqrjzlIWVFpSScQa8yjhvWBDM='; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
